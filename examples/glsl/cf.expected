uniform float speed;  // default 1.0
uniform float rings;  // default 18.0 range 0.0 .. 4.0
const float TAU = 6.283185307;
vec4 main(vec2 uv) {
  float acc = 0.0;
  for (int i = 0; i < 4; i++) {
    acc = (acc + speed);
  }
  if ((2.0 < acc)) {
    acc = (acc - 1.0);
  } else if ((acc < 0.0)) {
    acc = 0.0;
  } else {
    acc = (acc * TAU);
  }
  return vec4(vec3(acc, rings, 0.0), 1.0);
}


